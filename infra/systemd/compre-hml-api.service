# /etc/systemd/system/compre-hml-api.service  (homologação)
[Unit]
Description=Compre API (homologação)
After=network.target mysql.service

[Service]
User=compre
Group=compre
WorkingDirectory=/opt/compre/hml/current/backend
EnvironmentFile=/etc/compre/hml.env
ExecStart=/opt/compre/hml/venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker -w 3 -b 127.0.0.1:8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
