# /etc/systemd/system/compre-api.service  (produção)
[Unit]
Description=Compre API (produção)
After=network.target mysql.service

[Service]
User=compre
Group=compre
WorkingDirectory=/opt/compre/prod/current/backend
EnvironmentFile=/etc/compre/prod.env
ExecStart=/opt/compre/prod/venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker -w 3 -b 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
