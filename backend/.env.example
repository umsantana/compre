# Copie para .env (local) ou /etc/compre/<ambiente>.env (servidor). NUNCA versionar o .env.
ENV=local                      # local | hml | prod
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=compre_dev             # compre_dev | compre_hml | compre
DB_USER=compre_dev_app
DB_PASSWORD=Me108534@@##
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Origens permitidas no CORS (landpage). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false            # true em hml e prod (HTTPS)
ACCESS_TOKEN_MINUTES=60
